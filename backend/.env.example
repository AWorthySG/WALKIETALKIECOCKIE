# Public project endpoint; this is not the backend address.
LIVEKIT_URL=wss://walkie-talkie-cockie-1d244eqd.livekit.cloud
# Secrets must be set on your private backend, never inside the mobile app.
LIVEKIT_API_KEY=YOUR_NEW_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_NEW_LIVEKIT_API_SECRET
# Generate using: openssl rand -hex 32
APP_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORT=8787
# Use a persistent disk for this file in production.
DATA_FILE=./data/channels.json
